{
  "name": "ai-news-desktop",
  "version": "1.0.0",
  "description": "Czytnik AI Evolution News dla Windows",
  "main": "src/main.cjs",
  "author": "Marek",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/electron.cjs",
    "build": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "pl.marek.ainews",
    "productName": "AI News",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "src/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AI-News-${version}-Windows.exe"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}