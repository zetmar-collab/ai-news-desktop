{
  "name": "ai-news-desktop",
  "version": "1.0.1",
  "description": "Czytnik AI Evolution News dla Windows",
  "main": "src/main.cjs",
  "author": "Marek",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/electron.cjs",
    "build": "electron-builder --win portable --x64",
    "build:msix": "node scripts/build-msix.cjs",
    "test:msix": "node scripts/validate-msix.cjs"
  },
  "build": {
    "appId": "pl.marek.ainews",
    "productName": "AI News",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable",
      "icon": "src/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "AI-News-${version}-Windows.exe"
    },
    "appx": {
      "artifactName": "AI-News-${version}-Windows-${arch}.msix",
      "identityName": "MarekZettel-zetmar.AI-News",
      "applicationId": "AINews",
      "publisher": "CN=15A53D32-C868-48EE-B700-5DBB5449CA1B",
      "publisherDisplayName": "Marek Zettel - zetmar",
      "displayName": "AI-News",
      "backgroundColor": "#086D60",
      "languages": [
        "pl-PL"
      ],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  }
}
